# ==============================================================================
# APEX TEAM PORTAL - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local for local development.
# 2. In production (Vercel, Cloud Run, Supabase), configure these in your provider's dashboard.
# 3. NEVER commit real API keys or service-role secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / CLIENT-SAFE VARIABLES (Exposed to the browser via NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (safe for browser client requests; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Centralized Organization Timezone (e.g. Asia/Kolkata, America/New_York, UTC)
# All weekly Saturday reporting windows (11 AM, 4 PM, 6 PM reminders, 8 PM report) use this timezone.
NEXT_PUBLIC_TEAM_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER exposed to the browser or bundled in client JS)
# ------------------------------------------------------------------------------

# Shared secret token for authenticating scheduled cron invocations
# Used by external schedulers or Supabase pg_cron targeting /api/cron/weekly-scheduler
# Generate a high-entropy string (e.g. openssl rand -hex 32)
CRON_SECRET=your-secure-cron-secret-token

# Supabase Service Role Key (ONLY used for elevated administrative/bootstrap functions)
# CRITICAL: Keep this strictly server-side. Never prefix with NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server fallback timezone (optional, defaults to NEXT_PUBLIC_TEAM_TIMEZONE or Asia/Kolkata)
TEAM_TIMEZONE=Asia/Kolkata
